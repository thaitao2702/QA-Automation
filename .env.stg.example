# QA Platform — staging environment overlay (.env.stg)
# Copy this file to .env.stg and fill in real BO tokens. NEVER commit .env.stg.
# Loaded on top of the base .env when running with --env staging.
#
# Used only by bo_paytable_update test steps. Grab the access token (ctoken) and
# refresh token (rtoken) from the BO web app in browser DevTools
# (Application > Local Storage, keys ctoken / rtoken). The rotated access token
# is cached to .bo_token.stg.json (gitignored) across runs.

# Back-office API base URL for staging.
BO_API_BASE=https://staging-boapi.royaledge.io/sas-web/api/v1

# NOTE: Game-scoped BO identifiers (game_id, sas_entity_id, agent_id,
# currency_id, game_code) are NOT here — they live in
# games/<game>/env.config.yml under the `bo:` block (committed with the game).
# Set a BO_GAME_ID / BO_SAS_ENTITY_ID / BO_AGENT_ID / BO_CURRENCY_ID /
# BO_GAME_CODE env var here only to override that file for this environment.

# BO session tokens (secrets).
BO_TOKEN=your-staging-bo-access-token-here
BO_REFRESH_TOKEN=your-staging-bo-refresh-token-here

# --- Playsite launch (root config for url_script: get_game_url_playsite.py) ----
# Shared infra for resolving the game URL via the login flow. staging has no
# static 'url' in env.config.stg.yml, so the URL is always resolved here. The API
# base and player credentials live HERE; game-specific values (game_code,
# currency) live in the game's env.config `playsite:` block. Credentials are
# secrets — never commit them.
PLAYSITE_API_URL=https://staging.royaledge.io/api
PLAYSITE_USER=your-staging-player-username
PLAYSITE_PASS=your-staging-player-password
