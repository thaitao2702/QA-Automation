# QA Platform — Environment Variables (shared / base)
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
#
# Environment-specific config (back-office endpoint, game ids, BO tokens) lives
# in per-environment overlay files loaded on top of this one based on --env:
#   --env dev      -> .env.dev   (template: .env.dev.example)
#   --env staging  -> .env.stg   (template: .env.stg.example)
# Overlay values override the ones here.

# AI provider for visual assertions (image + video): gemini | local | claude
# - gemini: use the Google Gemini API (requires GEMINI_API_KEY below).
# - local:  use a self-hosted HTTP endpoint (requires LOCAL_AI_ENDPOINT below).
# - claude: sample video into frames and judge them with a Claude Code CLI
#           sub-agent (requires the `claude` CLI on PATH + ffmpeg; uses local
#           Claude Code auth, reported as $0). See CLAUDE_* vars below.
# Default: gemini
AI_PROVIDER=gemini

# Local AI endpoint, used when AI_PROVIDER=local.
# Accepts a multipart POST with a `file` and a `prompt` field and returns
# {"media_url": "...", "result": "<text>"}.
LOCAL_AI_ENDPOINT=http://192.168.1.35:9000/analyze

# Claude provider settings, used when AI_PROVIDER=claude.
# CLAUDE_AI_FPS:      frames/second sampled from the trimmed video (default 2).
# CLAUDE_CLI_PATH:    path/name of the claude executable (default "claude").
# CLAUDE_MODEL:       model passed to the CLI as --model (default "sonnet").
# CLAUDE_CLI_TIMEOUT: per-assert subprocess timeout in seconds (default 300).
CLAUDE_AI_FPS=2
# CLAUDE_CLI_PATH=claude
# CLAUDE_MODEL=sonnet
# CLAUDE_CLI_TIMEOUT=300

# Required for AI_PROVIDER=gemini: Gemini API key for AI-powered test assertions.
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# AI model for image assertions (screenshot analysis).
# Options: gemini-2.5-flash, gemini-3-flash-preview
# Default: gemini-2.5-flash (cheaper per image: $0.30/1M in, $2.50/1M out)
GEMINI_IMAGE_MODEL=gemini-2.5-flash

# AI model for video assertions (transition/sequence analysis).
# Options: gemini-2.5-flash, gemini-3-flash-preview
# Default: gemini-3-flash-preview (lower token/frame: 70 vs 256)
GEMINI_VIDEO_MODEL=gemini-3-flash-preview

# Video analysis resolution.
# Options: LOW, MEDIUM, HIGH
# Token cost per frame (1 frame/second):
#   gemini-3-flash-preview   LOW/MEDIUM: 70 tokens   HIGH: 280 tokens
#   gemini-2.5-flash         MEDIUM: 256 tokens       HIGH: 256 tokens
# Default: MEDIUM
GEMINI_VIDEO_RESOLUTION=MEDIUM

# Back-office (BO) config is NOT here — it is environment-specific and lives in
# the per-env overlays .env.dev / .env.stg (see .env.dev.example / .env.stg.example).
