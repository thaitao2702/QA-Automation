# QA Platform — local environment overlay (.env.local)
# Copy this file to .env.local and fill in real values. NEVER commit .env.local.
# Loaded on top of the base .env when running with --env local.
#
# local plays against the DEV backend but serves the game from a local IP, so the
# url_script in env.config.local.yml calls get_game_url_playsite.py --env=dev
# --base-url=http://192.168.1.65:7456. The credentials below are therefore the
# same DEV player account used for --env dev.

# Local plays against the dev API, so dev BO identifiers/tokens apply. Only set
# these if a test exercises bo_paytable_update steps locally.
BO_API_BASE=https://dev-boapi.royaledge.io/sas-web/api/v1
BO_TOKEN=your-dev-bo-access-token-here
BO_REFRESH_TOKEN=your-dev-bo-refresh-token-here

# --- Playsite launch (root config for url_script: get_game_url_playsite.py) ----
# Shared infra for resolving the game URL via the login flow. local has no static
# 'url' in env.config.local.yml, so the URL is always resolved here. local plays
# against the dev backend, so the API base + player are the same as dev. The API
# base and credentials live HERE; game-specific values (game_code, currency) live
# in the game's env.config `playsite:` block. Credentials are secrets — never commit.
PLAYSITE_API_URL=https://dev.royaledge.io/api
PLAYSITE_USER=your-dev-player-username
PLAYSITE_PASS=your-dev-player-password
