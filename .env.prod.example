# QA Platform — production environment overlay (.env.prod)
# Copy this file to .env.prod and fill in real values. NEVER commit .env.prod.
# Loaded on top of the base .env when running with --env prod.
#
# Production runs smoke/visual tests only; there is no BO (paytable) control,
# so the only thing needed here is the Playsite API base + player credentials
# used to resolve the game URL.

# --- Playsite launch (root config for url_script: get_game_url_playsite.py) ----
# Shared infra for resolving the game URL via the login flow. prod has no static
# 'url' in env.config.prod.yml, so the URL is always resolved here. The API base
# and player credentials live HERE; game-specific values (game_code, currency)
# live in the game's env.config `playsite:` block. Credentials are secrets —
# never commit them.
PLAYSITE_API_URL=https://play.royaledge.io/api
PLAYSITE_USER=your-prod-player-username
PLAYSITE_PASS=your-prod-player-password
