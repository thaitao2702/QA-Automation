# Test artifacts — can be large, regenerated on every run

# Local environment secrets (base + per-environment overlays), but keep templates
.env
.env.*
!.env.*.example

# Cached rotated BO access tokens, per environment (written by framework/helpers/bo.py)
.bo_token.*.json

# write-test working plan artifacts (regenerated on every /write-test run)
games/*/test-suites/*.plan.json

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Virtual environments
venv/
.venv/
env/
.env/
ENV/

# Python packaging
*.egg-info/
dist/
build/
*.egg

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~

# macOS
.DS_Store

