{
  "name": "scenario-runner",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript port of the scenario runner (scripts/run_scenario.py + scenario_engine.py)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "baseline": "python baseline/make_baseline.py",
    "run": "tsx src/runner/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@google/genai": "3.0.0",
    "playwright": "^1.58.0",
    "yaml": "^2.6.1"
  }
}
