# QA Platform — dev environment overlay (.env.dev)
# Copy this file to .env.dev and fill in real BO tokens. NEVER commit .env.dev.
# Loaded on top of the base .env when running with --env dev.
#
# Used only by bo_paytable_update test steps. Grab the access token (ctoken) and
# refresh token (rtoken) from the BO web app in browser DevTools
# (Application > Local Storage, keys ctoken / rtoken). The rotated access token
# is cached to .bo_token.dev.json (gitignored) across runs.

# Back-office API base URL for dev.  TODO: confirm the dev BO endpoint.
BO_API_BASE=https://dev-boapi.royaledge.io/sas-web/api/v1

# NOTE: Game-scoped BO identifiers (game_id, sas_entity_id, agent_id,
# currency_id, game_code) are NOT here — they live in
# games/<game>/env.config.yml under the `bo:` block (committed with the game).
# Set a BO_GAME_ID / BO_SAS_ENTITY_ID / BO_AGENT_ID / BO_CURRENCY_ID /
# BO_GAME_CODE env var here only to override that file for this environment.

# BO session tokens (secrets).
BO_TOKEN=your-dev-bo-access-token-here
BO_REFRESH_TOKEN=your-dev-bo-refresh-token-here

# --- Playsite launch (root config for url_script: get_game_url_playsite.py) ----
# Shared infra for resolving the game URL via the login flow (used when the game
# config's 'url' is empty so it falls back to 'url_script'). The API base and
# player credentials live HERE; game-specific values (game_code, currency) live
# in the game's env.config `playsite:` block. Credentials are secrets — never
# commit them.
PLAYSITE_API_URL=https://dev.royaledge.io/api
PLAYSITE_USER=your-dev-player-username
PLAYSITE_PASS=your-dev-player-password
